# Step 7 - Create a Kafka Supervisor

Create `kafka-supervisor.json`:

```json
{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "sales_rt",
      "timestampSpec": {
        "column": "timestamp",
        "format": "iso"
      },
      "dimensionsSpec": {
        "dimensions": [
          "city"
        ]
      },
      "metricsSpec": [
        {
          "type": "longSum",
          "name": "sales",
          "fieldName": "sales"
        }
      ],
      "granularitySpec": {
        "segmentGranularity": "DAY",
        "queryGranularity": "MINUTE",
        "rollup": true
      }
    },
    "ioConfig": {
      "topic": "sales-topic",
      "inputFormat": {
        "type": "json"
      },
      "consumerProperties": {
        "bootstrap.servers": "<VM4-IP>:9092"
      },
      "taskCount": 1,
      "replicas": 1
    },
    "tuningConfig": {
      "type": "kafka"
    }
  }
}
```

